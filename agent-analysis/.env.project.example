# agent-analysis 项目环境变量（示例模板，请勿提交真实密钥）
# 复制此文件为 .env.project 并根据环境修改

# =============================================================================
# LLM 提供商配置（二选一，优先级：KIMI > OpenAI-compatible）
# =============================================================================
# 方案 A：kimi-for-coding（Anthropic Messages API）
KIMI_BASE_URL=https://api.kimi.com/coding
KIMI_API_KEY=your-kimi-api-key
# 方案 B：OpenAI-compatible 端点（如本地 vLLM / 硅基流动）
# 当 KIMI_API_KEY 未设置时自动启用该方案
OPENAI_COMPATIBLE_CHAT_ENDPOINT=http://192.168.1.80:9998/v1/chat/completions
OPENAI_COMPATIBLE_EMBEDDING_ENDPOINT=http://192.168.1.80:9998/v1/embeddings
OPENAI_COMPATIBLE_CHAT_API_KEY=none

# =============================================================================
# 模型配置
# =============================================================================
DEFAULT_MODEL_NAME=k3
DEFAULT_EMBEDDING_MODEL=bge-m3
MAX_CONTEXT_LENGTH=8192
MAX_RESPONSE_TOKENS=2048
THINKING_DEPTH=medium
OMIT_AUTH=True

# =============================================================================
# 项目路径
# =============================================================================
PROJECT_ROOT=/opt/agent-analysis
RUNTIME_DIR=${PROJECT_ROOT}/data
KNOWLEDGE_DIR=${PROJECT_ROOT}/config/knowledge_tables
RULES_DIR=${PROJECT_ROOT}/config/diagnosis_rules
PIPELINE_CONFIG=${PROJECT_ROOT}/config/analysis_pipeline/default_pipeline.json
THRESHOLDS_CONFIG=${PROJECT_ROOT}/config/thresholds/default_thresholds.json

# =============================================================================
# 运行时约束
# =============================================================================
DISK_WARNING_THRESHOLD=95
TRACE_RETENTION_DAYS=30
TEMP_RETENTION_DAYS=7

# =============================================================================
# 日志配置
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
