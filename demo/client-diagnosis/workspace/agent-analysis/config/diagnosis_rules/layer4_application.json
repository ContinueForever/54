{
  "layer": "L4",
  "name": "应用层",
  "description": "检查端到端连通性、业务流量、应用性能",
  "rules": [
    {
      "id": "L4-R001",
      "name": "ping_unreachable",
      "description": "端到端ping不可达",
      "indicators": [
        "ping成功率低于阈值",
        "目的主机不可达",
        "路由不可达"
