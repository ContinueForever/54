      "pcap_indicators": [
        "LINK_PROBE_DEGRADATION"
      ],
      "references": []
    },
    {
      "id": "L4-R002",
      "name": "high_latency",
      "description": "端到端时延过高",
      "indicators": [
        "ping RTT超过阈值",
        "业务响应缓慢",
        "链路拥塞"
      ],
      "severity": "warning",
      "affected_layers": ["L2", "L3", "L4"],
      "suggestion": "检查链路带宽、QoS配置、路由路径",
      "references": []
    }
  ]
